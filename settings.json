{
  // View
  "workbench.tips.enabled": false, // stop showing shortcuts
  "breadcrumbs.enabled": false, // need thinking
  "workbench.tree.renderIndentGuides": "none", // no show lines in explorer tree
  "workbench.tree.indent": 16,
  "explorer.compactFolders": false,
  "explorer.decorations.badges": false, // remove additional info from explorer
  "git.decorations.enabled": true, // always show git changes in explorer
  "scm.diffDecorations":"all", // show all git changes in file
  "editor.occurrencesHighlight":"off", // stop show ident words if curson on it
  "editor.selectionHighlight": true, // if i select word i want show idents in file

  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "comment",
        "settings": {
          "fontStyle": "italic bold"
        }
      }
    ]
  },

  "editor.lightbulb.enabled": "off", // disable light icon in code for quick action

  "workbench.colorTheme": "Catppuccin Latte",
  "workbench.iconTheme": "vscode-great-icons",
  "workbench.sideBar.location": "left",
  "workbench.secondarySideBar.defaultVisibility": "hidden", // stop showing chat by default

  // show word wrap line
  "editor.rulers": [
    {
      "column": 80,
      "color": "#ff0000"
    }
  ],

  "editor.wordWrap": "wordWrapColumn", // move to next view line without creating real line
  "editor.wordWrapColumn": 80,

  // Tabs
  "editor.tabSize": 2, // effective for view and to short for big including
  "editor.useTabStops": true, // sometimes i have different code styles

  "editor.minimap.enabled": false, // no need minimap
  "editor.renderWhitespace": "trailing", // show whitespaces only in the end of line
  "files.trimTrailingWhitespace": true, // need thinking
  "files.insertFinalNewline": true, // need thinking

  "editor.inlayHints.enabled": "off", // no show helping info for save line space

  "editor.stickyScroll.enabled": true, // show start of class, func or etc at the top of the screen

  "output.smartScroll.enabled": false, // all actions which change "output" log need be showed in the moment
  "diffEditor.ignoreTrimWhitespace": false, // show all file changes


  // default terminal
  "terminal.external.linuxExec": "zsh",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.explorerKind": "external",
  "terminal.integrated.shellIntegration.enabled": false,

  "explorer.confirmDelete": false, // no need confirm delete action
  "explorer.confirmDragAndDrop": false, // disable DnD confirmation

  "containers.commands.build": "${containerCommand} build --pull --rm -f \"${dockerfile}\" -t ${tag} \"${context}\"", // why?

  // Font
  "editor.fontFamily": "Fira Code",
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
  "editor.fontSize": 14,
  "terminal.integrated.fontSize": 14,
  "debug.console.fontSize": 14,
  "markdown.preview.fontSize": 14,

  // git
  "git.enableSmartCommit": false, // for stop forgetting about stages
  "git.autofetch": false, // no need sync remote and local changes auto
  "git.confirmSync": false, // when i click to sync i ready to make it

  // zen mode
  "zenMode.hideLineNumbers": false,
  "zenMode.showTabs": "none", // need thinking
  "zenMode.centerLayout": true,
  "zenMode.fullScreen": true,
  "zenMode.restore": true,


  // disable all sounds
  "accessibility.signalOptions.volume": 0,
    "accessibility.signals.chatEditModifiedFile": {
    "sound": "off"
  },
  "accessibility.signals.chatRequestSent": {
    "sound": "off"
  },
  "accessibility.signals.chatResponseReceived": {
    "sound": "off"
  },
  "accessibility.signals.chatUserActionRequired": {
    "sound": "off"
  },
  "accessibility.signals.clear": {
    "sound": "off"
  },
  "accessibility.signals.codeActionApplied": {
    "sound": "off"
  },
  "accessibility.signals.codeActionTriggered": {
    "sound": "off"
  },
  "accessibility.signals.diffLineDeleted": {
    "sound": "off"
  },
  "accessibility.signals.diffLineInserted": {
    "sound": "off"
  },
  "accessibility.signals.diffLineModified": {
    "sound": "off"
  },
  "accessibility.signals.editsKept": {
    "sound": "off"
  },
  "accessibility.signals.editsUndone": {
    "sound": "off"
  },
  "accessibility.signals.lineHasBreakpoint": {
    "sound": "off"
  },
  "accessibility.signals.lineHasError": {
    "sound": "off"
  },
  "accessibility.signals.lineHasFoldedArea": {
